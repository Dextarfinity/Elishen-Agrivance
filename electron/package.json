{
  "name": "bookkeeping-desktop",
  "version": "1.0.0",
  "description": "Elishen Agrivance â€” Sales & Inventory Management System",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
